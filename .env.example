# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
DB_PATH=./data/campus-wifi.sqlite
TIMEZONE=Africa/Nairobi

# CPE centralized management (live status, devices, signal, restart)
CPE_INDOOR_HOST=192.168.18.1
CPE_OUTDOOR_HOST=192.168.254.1
# Set each device's REAL admin web password here ('@dM!N' was verified rejected by both).
CPE_ADMIN_PASSWORD=
# Per-device overrides (used when a gateway's password differs from CPE_ADMIN_PASSWORD):
CPE_INDOOR_PASSWORD=
CPE_OUTDOOR_PASSWORD=
