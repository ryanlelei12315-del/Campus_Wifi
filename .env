# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
DB_PATH=./data/campus-wifi.sqlite
TIMEZONE=Africa/Nairobi
CPE_INDOOR_HOST=192.168.18.1
CPE_OUTDOOR_HOST=192.168.254.1
# NOTE: @dM!N was REJECTED by both CPEs (verified against each device own firmware
# login algorithm: MF253V = sha256(sha256(pw)+LD), MC8830 = sha256(sha256(pw)+sault)).
# Set each device REAL admin web password here, then restart the app.
CPE_ADMIN_PASSWORD=@dM!N
